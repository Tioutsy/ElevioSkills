{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && npm run build && node --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "node --test --test-concurrency=1 --import tsx ./src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:verify": "tsx src/scripts/verifyDatabaseSchema.ts",
    "db:repair": "tsx src/scripts/repairProductionSchema.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.26",
    "@clerk/shared": "^4.17.1",
    "@google/genai": "^2.23.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.1.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.24.0",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "thread-stream": "^3.1.0",
    "tsx": "^4.19.0"
  }
}
