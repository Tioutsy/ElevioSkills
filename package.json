{
  "name": "ecolearn-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@workspace/ecolearn",
    "dev:api": "npm run dev --workspace=@workspace/api-server",
    "build": "npm run build --workspace=@workspace/ecolearn",
    "typecheck": "npm run typecheck --workspace=@workspace/ecolearn",
    "lint": "npm run typecheck --workspace=@workspace/ecolearn",
    "unpublish:courses": "node scripts/unpublish-courses-36-to-139.mjs"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.63.3",
    "@rollup/wasm-node": "^4.63.3",
    "@tailwindcss/oxide-darwin-arm64": "^4.3.3",
    "@tailwindcss/oxide-wasm32-wasi": "^4.3.3",
    "lightningcss-darwin-arm64": "^1.33.0",
    "lightningcss-wasm": "^1.33.0",
    "rollup": "npm:@rollup/wasm-node@^4.63.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3"
  }
}
